{
  "name": "@token-vault/webhook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:node": "tsx watch src/runtime/node.ts",
    "dev:worker": "wrangler dev src/runtime/worker.ts",
    "build": "tsc --noEmit && wrangler deploy --dry-run",
    "deploy": "sh scripts/deploy.sh",
    "deploy:plain": "wrangler deploy src/runtime/worker.ts",
    "ensure-seed": "sh scripts/ensure-seed.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@hono/node-server": "^1.19.17",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
